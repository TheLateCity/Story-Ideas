{{!-- Half filled circle. The word says where the control leads, not
      where the reader is. Hidden without JavaScript, because a
      control that cannot work should not be offered. --}}

<button class="lc-toggle" type="button" data-lc-theme-toggle aria-label="Switch colour theme">
    <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="10.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M12 1.8a10.2 10.2 0 0 1 0 20.4z" fill="currentColor"></path>
    </svg>
    <span data-lc-theme-label>Dark</span>
</button>
