{{!< default}}

{{!-- Composed rather than clever. A reader who has arrived at a
      missing page is not in the mood for a joke. --}}

{{#contentFor "chrome"}}compact{{/contentFor}}
{{#contentFor "where"}}Not found{{/contentFor}}

<section class="lc-error">
    <div class="lc-wrap">
        <div class="lc-error-in">
            <span class="lc-label"><b>{{@site.title}}</b><span class="lc-div" aria-hidden="true">/</span>404</span>
            <h1>This page is not in the archive.</h1>
            <p>The address may have changed, or the story may never have been at it. Everything published is reachable from the front page.</p>
            <a class="lc-back" href="{{@site.url}}/">Return to the front page</a>
        </div>
    </div>
</section>

{{#get "posts" limit="3" include="authors,tags"}}
    {{#if posts}}
    <section class="lc-band" aria-labelledby="lc-404-latest">
        <div class="lc-wrap">
            <div class="lc-band-head">
                <h2 id="lc-404-latest">Latest</h2>
                <span class="lc-note">Most recently published</span>
            </div>
            <div class="lc-latest">
                {{#foreach posts}}{{> "story" variant="row"}}{{/foreach}}
            </div>
        </div>
    </section>
    {{/if}}
{{/get}}
